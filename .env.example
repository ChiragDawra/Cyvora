# Copy to .env and fill in. .env is gitignored - never commit real values.
#
# infra/run.sh and infra/bootstrap.sh source this file. run.sh additionally maps the
# three feed keys to the TF_VAR_* names Terraform expects, so the names here must match.

# --- AWS credentials -----------------------------------------------------------------
# An IAM user with permission to create the stack. Not the root account.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Feed API keys -------------------------------------------------------------------
# abuse.ch Auth-Key, mandatory since June 2025. One key covers both URLhaus and Feodo.
# Register at https://auth.abuse.ch
ABUSECH_AUTH_KEY=

# AbuseIPDB, free tier is 1,000 checks/day. The enricher is capped at 400/day.
# Register at https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# AlienVault OTX. The account must also subscribe to at least one pulse - the
# /pulses/subscribed endpoint returns only what it follows, so an unsubscribed account
# lands an empty payload without erroring, which looks like success.
# Register at https://otx.alienvault.com (Settings > OTX API)
OTX_API_KEY=
